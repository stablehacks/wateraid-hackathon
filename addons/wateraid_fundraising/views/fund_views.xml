<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fundraising_campaign_tree" model="ir.ui.view">
        <field name="name">fundraising.campaign.tree</field>
        <field name="model">fundraising.campaign</field>
        <field name="arch" type="xml">
            <tree string="Fundraising Campaigns">
                <field name="code"/>
                <field name="name"/>
                <field name="target_amount" sum="Total Goals"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_fundraising_campaign_form" model="ir.ui.view">
        <field name="name">fundraising.campaign.form</field>
        <field name="model">fundraising.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaign">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Clean Water for East Africa 2026-2029"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="target_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Designated Funds">
                            <field name="fund_ids">
                                <tree editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="fund_type"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fundraising_fund_tree" model="ir.ui.view">
        <field name="name">fundraising.fund.tree</field>
        <field name="model">fundraising.fund</field>
        <field name="arch" type="xml">
            <tree string="Designated Funds">
                <field name="code"/>
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="fund_type" widget="badge"/>
            </tree>
        </field>
    </record>
</odoo>
