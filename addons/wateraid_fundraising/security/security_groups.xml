<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wateraid_fundraising" model="ir.module.category">
        <field name="name">WaterAid Fundraising</field>
        <field name="description">User access levels for WaterAid Canada fundraising and CRA tax receipting.</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_fundraising_user" model="res.groups">
        <field name="name">Fundraising Officer (User)</field>
        <field name="category_id" ref="module_category_wateraid_fundraising"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_fundraising_manager" model="res.groups">
        <field name="name">Director of Development / Finance (Manager)</field>
        <field name="category_id" ref="module_category_wateraid_fundraising"/>
        <field name="implied_ids" eval="[(4, ref('group_fundraising_user'))]"/>
    </record>
</odoo>
